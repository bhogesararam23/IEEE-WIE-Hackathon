# Reverse proxy + automatic HTTPS (Let's Encrypt) for the HerMediSafe API.
#
# Replace the line below with your own address before starting the stack:
#   - No domain? Use <your-vm-public-ip>.nip.io, e.g. 140.238.12.34.nip.io
#     (nip.io / sslip.io resolve that hostname straight to the embedded IP --
#     no registrar, no signup, no cost.)
#   - Have a real domain? Point an A record at the VM's public IP and put the
#     domain here instead.
#
# Caddy handles the certificate automatically: nothing else to configure.

your-vm-public-ip.nip.io {
	reverse_proxy app:8000
}
