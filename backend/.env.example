# Copy to .env and adjust. Never commit the real .env.
#   cp .env.example .env

# --- Application ------------------------------------------------------------
APP_NAME=HerMediSafe API
APP_VERSION=0.1.0
ENVIRONMENT=local
DEBUG=True

# --- Database ---------------------------------------------------------------
# Local development: Postgres running on the host (or the compose `db` service
# with its port published to localhost).
# Driver must be the async one: postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://hermedisafe:hermedisafe@localhost:5432/hermedisafe

# Inside docker compose the app connects to the `db` service instead:
# DATABASE_URL=postgresql+asyncpg://hermedisafe:hermedisafe@db:5432/hermedisafe

DB_ECHO=False
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_HEALTH_TIMEOUT=5.0

# Also used by docker-compose to initialise the Postgres container.
POSTGRES_USER=hermedisafe
POSTGRES_PASSWORD=hermedisafe
POSTGRES_DB=hermedisafe
POSTGRES_PORT=5432

# --- CORS -------------------------------------------------------------------
# JSON list. Hackathon mode allows every origin.
# Credentials stay off while the wildcard is in place: browsers reject
# `Access-Control-Allow-Origin: *` together with `Allow-Credentials: true`.
CORS_ORIGINS=["*"]
CORS_ALLOW_CREDENTIALS=False

# --- Security / JWT ---------------------------------------------------------
# CHANGE THIS before deploying. The app logs a warning at startup while the
# built-in default is in use, because anyone holding it can mint a token for any
# user id. Generate one with: openssl rand -hex 32
SECRET_KEY=dev-insecure-change-me
JWT_ALGORITHM=HS256
JWT_ISSUER=hermedisafe-api
# 24h, per the "hackathon simplicity" brief. There are no refresh tokens, so
# this is the real session length.
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Cost factor for bcrypt. 12 is ~250ms per hash on typical hardware; raise it to
# slow offline cracking, at the cost of login latency.
BCRYPT_ROUNDS=12
