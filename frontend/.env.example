# Where the HerMediSafe API is listening.
# Port 8010 because 8000 is free on some machines and taken on others --
# change it here if you moved the backend.
VITE_API_BASE_URL=http://localhost:8010

# OAuth 2.0 Web client ID from Google Cloud Console (APIs & Services ->
# Credentials) -- the same value the backend's GOOGLE_CLIENT_ID must be set
# to. Without it, the "Sign in with Google" button doesn't render.
VITE_GOOGLE_CLIENT_ID=
